{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start All (STMS)",
      "dependsOn": [
        "Start Backend",
        "Start Dashboard",
        "Start Client"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Start Backend",
      "type": "shell",
      "command": "npm start",
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Start Dashboard",
      "type": "shell",
      "command": "npm start",
      "options": {
        "cwd": "${workspaceFolder}/Dashboard"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Start Client",
      "type": "shell",
      "command": "npm start",
      "options": {
        "cwd": "${workspaceFolder}/client"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Seed Database",
      "type": "shell",
      "command": "node seed.js",
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "problemMatcher": []
    }
  ]
}
